# OpenJCEPlus Provider Configuration with OpenSSL Backend
# This configuration file sets up services to use the OpenSSL native implementation
# instead of the default OCK (Open Crypto Kit) backend.

name = OpenJCEPlus
description = OpenJCEPlus Provider with OpenSSL Backend

# Load default provider services
default = true

# =======================================================================
# Configure SecureRandom Services to use OpenSSL
# =======================================================================

# DRBG (Deterministic Random Bit Generator) using OpenSSL EVP_RAND
SecureRandom.SHA256DRBG.attr.add.NativeProvider = OpenSSL
SecureRandom.SHA512DRBG.attr.add.NativeProvider = OpenSSL

# =======================================================================
# Configure Cipher Services to use OpenSSL
# =======================================================================

# AES Cipher modes
Cipher.AES.attr.add.NativeProvider = OpenSSL
Cipher.AES/GCM/NoPadding.attr.add.NativeProvider = OpenSSL
Cipher.AES/CCM/NoPadding.attr.add.NativeProvider = OpenSSL

# AES Key Wrap
Cipher.AES/KW/NoPadding.attr.add.NativeProvider = OpenSSL
Cipher.AES/KWP/NoPadding.attr.add.NativeProvider = OpenSSL
Cipher.AES_128/KW/NoPadding.attr.add.NativeProvider = OpenSSL
Cipher.AES_128/KWP/NoPadding.attr.add.NativeProvider = OpenSSL
Cipher.AES_192/KW/NoPadding.attr.add.NativeProvider = OpenSSL
Cipher.AES_192/KWP/NoPadding.attr.add.NativeProvider = OpenSSL
Cipher.AES_256/KW/NoPadding.attr.add.NativeProvider = OpenSSL
Cipher.AES_256/KWP/NoPadding.attr.add.NativeProvider = OpenSSL

# =======================================================================
# Configure MessageDigest Services to use OpenSSL
# =======================================================================

MessageDigest.MD5.attr.add.NativeProvider = OpenSSL
MessageDigest.SHA-1.attr.add.NativeProvider = OpenSSL
MessageDigest.SHA-224.attr.add.NativeProvider = OpenSSL
MessageDigest.SHA-256.attr.add.NativeProvider = OpenSSL
MessageDigest.SHA-384.attr.add.NativeProvider = OpenSSL
MessageDigest.SHA-512.attr.add.NativeProvider = OpenSSL
MessageDigest.SHA-512/224.attr.add.NativeProvider = OpenSSL
MessageDigest.SHA-512/256.attr.add.NativeProvider = OpenSSL
MessageDigest.SHA3-224.attr.add.NativeProvider = OpenSSL
MessageDigest.SHA3-256.attr.add.NativeProvider = OpenSSL
MessageDigest.SHA3-384.attr.add.NativeProvider = OpenSSL
MessageDigest.SHA3-512.attr.add.NativeProvider = OpenSSL

# =======================================================================
# Configure MAC (HMAC) Services to use OpenSSL
# =======================================================================

MAC.HmacMD5.attr.add.NativeProvider = OpenSSL
MAC.HmacSHA1.attr.add.NativeProvider = OpenSSL
MAC.HmacSHA224.attr.add.NativeProvider = OpenSSL
MAC.HmacSHA256.attr.add.NativeProvider = OpenSSL
MAC.HmacSHA384.attr.add.NativeProvider = OpenSSL
MAC.HmacSHA512.attr.add.NativeProvider = OpenSSL
MAC.HmacSHA512/224.attr.add.NativeProvider = OpenSSL
MAC.HmacSHA512/256.attr.add.NativeProvider = OpenSSL
MAC.HmacSHA3-224.attr.add.NativeProvider = OpenSSL
MAC.HmacSHA3-256.attr.add.NativeProvider = OpenSSL
MAC.HmacSHA3-384.attr.add.NativeProvider = OpenSSL
MAC.HmacSHA3-512.attr.add.NativeProvider = OpenSSL

# =======================================================================
# Configure Signature Services to use OpenSSL
# =======================================================================

# RSA Signatures
Signature.MD5withRSA.attr.add.NativeProvider = OpenSSL
Signature.SHA1withRSA.attr.add.NativeProvider = OpenSSL
Signature.SHA224withRSA.attr.add.NativeProvider = OpenSSL
Signature.SHA256withRSA.attr.add.NativeProvider = OpenSSL
Signature.SHA384withRSA.attr.add.NativeProvider = OpenSSL
Signature.SHA512withRSA.attr.add.NativeProvider = OpenSSL
Signature.SHA512/224withRSA.attr.add.NativeProvider = OpenSSL
Signature.SHA512/256withRSA.attr.add.NativeProvider = OpenSSL
Signature.SHA3-224withRSA.attr.add.NativeProvider = OpenSSL
Signature.SHA3-256withRSA.attr.add.NativeProvider = OpenSSL
Signature.SHA3-384withRSA.attr.add.NativeProvider = OpenSSL
Signature.SHA3-512withRSA.attr.add.NativeProvider = OpenSSL

# RSA-PSS Signatures
Signature.RSASSA-PSS.attr.add.NativeProvider = OpenSSL
Signature.SHA224withRSAandMGF1.attr.add.NativeProvider = OpenSSL
Signature.SHA256withRSAandMGF1.attr.add.NativeProvider = OpenSSL
Signature.SHA384withRSAandMGF1.attr.add.NativeProvider = OpenSSL
Signature.SHA512withRSAandMGF1.attr.add.NativeProvider = OpenSSL
Signature.SHA512/224withRSAandMGF1.attr.add.NativeProvider = OpenSSL
Signature.SHA512/256withRSAandMGF1.attr.add.NativeProvider = OpenSSL
Signature.SHA3-224withRSAandMGF1.attr.add.NativeProvider = OpenSSL
Signature.SHA3-256withRSAandMGF1.attr.add.NativeProvider = OpenSSL
Signature.SHA3-384withRSAandMGF1.attr.add.NativeProvider = OpenSSL
Signature.SHA3-512withRSAandMGF1.attr.add.NativeProvider = OpenSSL

# DSA Signatures
Signature.SHA1withDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA224withDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA256withDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA384withDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA512withDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA3-224withDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA3-256withDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA3-384withDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA3-512withDSA.attr.add.NativeProvider = OpenSSL

# ECDSA Signatures
Signature.NONEwithECDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA1withECDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA224withECDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA256withECDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA384withECDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA512withECDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA3-224withECDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA3-256withECDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA3-384withECDSA.attr.add.NativeProvider = OpenSSL
Signature.SHA3-512withECDSA.attr.add.NativeProvider = OpenSSL

# EdDSA Signatures
Signature.EdDSA.attr.add.NativeProvider = OpenSSL
Signature.Ed25519.attr.add.NativeProvider = OpenSSL
Signature.Ed448.attr.add.NativeProvider = OpenSSL

# \=======================================================================
# Configure KeyPairGenerator Services to use OpenSSL
# \=======================================================================

# RSA KeyPairGenerator
KeyPairGenerator.RSA.attr.add.NativeProvider = OpenSSL
KeyPairGenerator.RSA.attr.add.SupportedKeyClasses = java.security.interfaces.RSAPublicKey|java.security.interfaces.RSAPrivateKey

# EC (Elliptic Curve) KeyPairGenerator
KeyPairGenerator.EC.attr.add.NativeProvider = OpenSSL
KeyPairGenerator.EC.attr.add.SupportedKeyClasses = java.security.interfaces.ECPublicKey|java.security.interfaces.ECPrivateKey

# DSA KeyPairGenerator
KeyPairGenerator.DSA.attr.add.NativeProvider = OpenSSL
KeyPairGenerator.DSA.attr.add.SupportedKeyClasses = java.security.interfaces.DSAPublicKey|java.security.interfaces.DSAPrivateKey

# EdDSA KeyPairGenerator
KeyPairGenerator.EdDSA.attr.add.NativeProvider = OpenSSL
KeyPairGenerator.Ed25519.attr.add.NativeProvider = OpenSSL
KeyPairGenerator.Ed448.attr.add.NativeProvider = OpenSSL
KeyPairGenerator.EdDSA.attr.add.SupportedKeyClasses = java.security.interfaces.EdECPublicKey|java.security.interfaces.EdECPrivateKey

# DH (Diffie-Hellman) KeyPairGenerator
KeyPairGenerator.DH.attr.add.NativeProvider = OpenSSL
KeyPairGenerator.DiffieHellman.attr.add.NativeProvider = OpenSSL
KeyPairGenerator.DH.attr.add.SupportedKeyClasses = javax.crypto.interfaces.DHPublicKey|javax.crypto.interfaces.DHPrivateKey

# =======================================================================
# Configure KDF Services to use OpenSSL
# =======================================================================

# PBKDF2
SecretKeyFactory.PBKDF2WithHmacSHA1.attr.add.NativeProvider = OpenSSL
SecretKeyFactory.PBKDF2WithHmacSHA224.attr.add.NativeProvider = OpenSSL
SecretKeyFactory.PBKDF2WithHmacSHA256.attr.add.NativeProvider = OpenSSL
SecretKeyFactory.PBKDF2WithHmacSHA384.attr.add.NativeProvider = OpenSSL
SecretKeyFactory.PBKDF2WithHmacSHA512.attr.add.NativeProvider = OpenSSL
SecretKeyFactory.PBKDF2WithHmacSHA512/224.attr.add.NativeProvider = OpenSSL
SecretKeyFactory.PBKDF2WithHmacSHA512/256.attr.add.NativeProvider = OpenSSL

# HKDF
KDF.HKDF-SHA1.attr.add.NativeProvider = OpenSSL
KDF.HKDF-SHA224.attr.add.NativeProvider = OpenSSL
KDF.HKDF-SHA256.attr.add.NativeProvider = OpenSSL
KDF.HKDF-SHA384.attr.add.NativeProvider = OpenSSL
KDF.HKDF-SHA512.attr.add.NativeProvider = OpenSSL

# =======================================================================
# Notes:
# =======================================================================
#
# 1. Services not listed above will use the default OCK backend
#
# 2. To use this configuration, load it when creating the provider:
#
#    Provider provider = new OpenJCEPlus();
#    provider = ((OpenJCEPlus) provider).configure("src/test/ProviderOpenSSLAttrs.config");
#    Security.insertProviderAt(provider, 1);  // Insert at position 1 (highest priority)
#
# 3. IMPORTANT: Provider must be inserted at position 1 for SecureRandom to work correctly
#    When using new SecureRandom() without specifying an algorithm, Java defaults to
#    SHA512DRBG. Both SHA256DRBG and SHA512DRBG must be configured with OpenSSL backend.
#
# 4. Ensure the OpenSSL native library (libjgskit_openssl_64.dll/so/dylib)
#    is available in the library path
#
# 5. For FIPS mode, use OpenJCEPlusFIPS provider with appropriate configuration